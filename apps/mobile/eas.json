{
  "cli": {
    "version": ">= 10.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "environment": "preview",
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "gomoto"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "gomoto"
      }
    },
    "preview-locawone": {
      "extends": "preview",
      "env": {
        "APP_VARIANT": "locawone"
      }
    },
    "production-locawone": {
      "extends": "production",
      "env": {
        "APP_VARIANT": "locawone"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
