# ============================================================
# GoMoto — Variáveis de ambiente para desenvolvimento LOCAL
# ============================================================
#
# Para usar:
#   1. cp .env.local.example .env.local
#   2. npm run db:start
#   3. npm run db:status  (mostra as chaves abaixo já preenchidas)
#   4. Cole as chaves de `db:status` neste arquivo
#
# Diferente do .env.example (que aponta para produção/cloud),
# este aponta para o stack Supabase rodando em Docker localmente.
# ============================================================

# Supabase local (Docker)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# anon key (pegue de `npm run db:status` — campo "anon key")
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service role key — NUNCA exposta no client (pegue de `npm run db:status`)
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do app — usada como base do redirectTo em generateLink()
# (convite de Platform Admin/Usuário do Sistema, Spec 0011 §11.2). Precisa
# estar na allowlist de Redirect URLs do projeto Supabase (Studio local
# http://127.0.0.1:54323 → Authentication → URL Configuration).
# Desenvolvimento: http://127.0.0.1:3000 — Produção: https://seu-dominio.vercel.app
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# Domínio raiz do login personalizado por locadora (ADR 0042):
# {subdominio}.<raiz>/login mostra o logo da locadora.
# Desenvolvimento: localhost (http://empresa1.localhost:3000/login) — Produção: locaw.com.br
NEXT_PUBLIC_ROOT_DOMAIN=localhost

# ============================================================
# Mercado Pago OAuth (Checkout Transparente — Payments API)
# Documentação: https://www.mercadopago.com.br/developers/panel
# ============================================================

# Client ID da aplicação (igual para teste e produção)
MERCADOPAGO_CLIENT_ID=

# Client Secret da aplicação (igual para teste e produção)
MERCADOPAGO_CLIENT_SECRET=

# URL de callback OAuth — deve ser registrada no portal do MP
# Em desenvolvimento: http://localhost:3000/api/auth/mercadopago/callback
MERCADOPAGO_REDIRECT_URI=http://localhost:3000/api/auth/mercadopago/callback

# ============================================================
# Extração de Documentos via IA (Spec 0012 / ADR 0023)
# Vercel AI Gateway — https://vercel.com/docs/ai-gateway
# ============================================================

# Chave do AI Gateway (necessária pra extração de CNH/multa via Gemini rodar
# de verdade). Sem ela, extractCnhFields/extractFineNoticeFields falham em
# runtime com EXTRACTION_FAILED só quando o operador de fato anexa um
# documento — não bloqueia build nem o resto do app.
AI_GATEWAY_API_KEY=

# Só pra rodar a suíte E2E de extração (document-extraction-*.spec.ts) —
# NUNCA setar em produção. Substitui a chamada ao Gemini por um resultado
# fixo, sem gastar chamada de IA. Setar ao iniciar o dev server, não aqui:
#   DOCUMENT_EXTRACTION_MOCK=1 pnpm --filter web dev
# (ver obsidian-notes/Desenvolvimento Local.md)

# ============================================================
# Gateways de pagamento (ADR 0030)
# ============================================================
# A URL de retorno do OAuth é derivada de NEXT_PUBLIC_APP_URL:
#   <NEXT_PUBLIC_APP_URL>/api/auth/gateway/<provedor>/callback
# É ELA que precisa estar registrada no painel de cada provedor.

# Assina o `state` do OAuth. Opcional: sem ela, cai em SUPABASE_SERVICE_ROLE_KEY.
GATEWAY_OAUTH_SECRET=

# --- Mercado Pago (OAuth2) ---
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=

# --- Cora, modalidade Parceria (OAuth2 authorization_code) ---
# Homologação: https://api.stage.cora.com.br | Produção: https://api.cora.com.br
# Sem certificado — mTLS é a "Integração Direta", que não é a nossa modalidade.
CORA_API_BASE=https://api.stage.cora.com.br
CORA_CLIENT_ID=
CORA_CLIENT_SECRET=
# Segredo no PATH do webhook. A Cora não assina a notificação nem oferece campo
# de autenticação no cadastro do endpoint, então a URL secreta é a primeira das
# três camadas de defesa (as outras: reconsultar a invoice na API e resolver o
# tenant pelo nosso payment_intents). Gerar com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CORA_WEBHOOK_SECRET=

# ============================================================
# Mercado Pago — Edge Function (Supabase)
# Configurado via: supabase secrets set MERCADOPAGO_WEBHOOK_SECRET=<valor>
# Documentado aqui apenas para referência — NÃO vai no .env.local do Next.js
# ============================================================
# MERCADOPAGO_WEBHOOK_SECRET=  # gerado no painel MP → Integrações → Webhooks

# ============================================================
